# ---------------------------------------------------------------------------
# Supabase (PostgreSQL + Auth)
# ---------------------------------------------------------------------------
# Project URL and anon key are safe to expose to the browser (protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS — never expose to the client, never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection. Required by scripts/migrate.ts and
# scripts/seed-events.ts, which run DDL and bulk inserts that the REST API
# cannot express. Dashboard: Project Settings -> Database -> Connection string.
# Use the Session pooler URI (port 5432) if your network has no IPv6 route.
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Cloudflare R2 (image storage, S3-compatible API)
# ---------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=history-images

# Public read base URL for the bucket: either the r2.dev dev domain or your own
# CDN domain. No trailing slash. Image URLs are built as `${base}/${object_key}`.
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://images.example.com

# ---------------------------------------------------------------------------
# Local two-device testing (optional, dev only)
# ---------------------------------------------------------------------------
# Origin written into a head-to-head invite (link, WhatsApp message and QR
# code) instead of the page's own. Set it to this machine's LAN address so a
# phone scanning the QR reaches *this* dev server rather than resolving
# `localhost` to itself. Applied only when the page is on a loopback host, so
# it is inert on a deployed build. Leave unset in production.
# NEXT_PUBLIC_DEV_INVITE_ORIGIN=http://192.168.1.2:3000
