    "db:migrate": "node --experimental-strip-types --no-warnings scripts/migrate.ts",
    "db:seed:events": "node --experimental-strip-types --no-warnings scripts/seed-events.ts",
    "db:seed:football": "node --experimental-strip-types --no-warnings scripts/seed-football.ts",
    "db:seed:basketball": "node --experimental-strip-types --no-warnings scripts/seed-basketball.ts",
    "db:seed:screen": "node --experimental-strip-types --no-warnings scripts/seed-screen.ts",
    "db:seed:when-born": "node --experimental-strip-types --no-warnings scripts/seed-when-born.ts",
    "events:check": "node --experimental-strip-types --no-warnings scripts/check-events.ts",
    "football:check": "node --experimental-strip-types --no-warnings scripts/check-football.ts",
    "basketball:check": "node --experimental-strip-types --no-warnings scripts/check-basketball.ts",
    "screen:check": "node --experimental-strip-types --no-warnings scripts/check-screen.ts",
    "when-born:check": "node --experimental-strip-types --no-warnings scripts/check-when-born.ts",
    "image:attach": "node --experimental-strip-types --no-warnings scripts/attach-image.ts",
